{
  "name": "cooking-base",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "bump": "node scripts/bump-version.js",
    "build:uat:ios": "node scripts/bump-version.js && eas build --platform ios --profile uat",
    "build:uat:android": "node scripts/bump-version.js && eas build --platform android --profile uat",
    "build:store:ios": "node scripts/bump-version.js && eas build --platform ios --profile store",
    "build:store:android": "node scripts/bump-version.js && eas build --platform android --profile store"
  },
  "private": true
}
